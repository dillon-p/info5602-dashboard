{
  "name": "work-recharted",
  "private": true,
  "version": "0.1.0",
  "description": "Explore projected employment growth, median wages, and relative AI exposure across occupations.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "test": "python3 -m unittest discover -s analytics/tests",
    "data:download": "python3 -m analytics.scripts.download_snapshot",
    "data:refresh": "python3 -m analytics.scripts.refresh_data",
    "preview": "vite preview"
  },
  "dependencies": {
    "chart.js": "^4.6.1",
    "react": "^19.3.1",
    "react-chartjs-2": "^5.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "oxlint": "^1.89.0",
    "typescript": "~7.0.2",
    "vite": "^8.3.5"
  }
}
